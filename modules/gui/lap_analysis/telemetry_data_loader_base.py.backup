class TelemetryApiWorker(QThread):
    """Background worker responsible for fetching telemetry comparison data via REST API."""

    progress = pyqtSignal(int)
    success = pyqtSignal(dict)
    failure = pyqtSignal(str)

    def __init__(self, base_url: str, params: Dict[str, Any], timeout: float = 75.0,
                 request_token: Optional[int] = None, parent=None):
        super().__init__(parent)
        self.base_url = (base_url or "http://localhost:8000").rstrip('/')
        self.params = dict(params)
        self.timeout = timeout
        self.request_token = request_token
        # 隤輯岫鞈?
        self._worker_id = f"APIW-{int(time.time()*1000)}-{id(self)}"
        self._log_path = os.path.join("logs", "api_worker_debug.log")
        try:
            os.makedirs(os.path.dirname(self._log_path), exist_ok=True)
        except Exception:
            pass

    # 頛?蝝神瑼隤?銝僕?曉??logger 閮剖?嚗?    def _log(self, message: str) -> None:
        ts = datetime.now().strftime('%H:%M:%S.%f')[:-3]
        line = f"[{ts}] [{self._worker_id}] {message}"
        try:
            # console
            print(f"[API_WORKER] {line}")
        except Exception:
            pass
        try:
            with open(self._log_path, 'a', encoding='utf-8') as f:
                f.write(line + "\n")
        except Exception:
            pass

    def run(self) -> None:
        start_ts = time.perf_counter()
        thread_ident = threading.get_ident()
        try:
            self._log(f"run() start; thread={thread_ident} token={self.request_token} base={self.base_url}")
            self.progress.emit(15)
            endpoint = f"{self.base_url}/api/v2/analysis/execute"
            query_params: Dict[str, Any] = {
                "function_id": 13,
                "year": int(self.params.get("year")),
                "race": self.params.get("race"),
                "session": self.params.get("session"),
                "driver1": self.params.get("driver1"),
                "driver2": self.params.get("driver2"),
                "lap1": self.params.get("lap1"),
                "lap2": self.params.get("lap2"),
            }

            if self.params.get("force_refresh"):
                query_params["force_refresh"] = True

            # 蝝???菔?瘙??賂??踹??頛詨嚗?            self._log(
                "POST /api/v2/analysis/execute "
                f"params={{y:{query_params.get('year')}, r:{query_params.get('race')}, "
                f"s:{query_params.get('session')}, d1:{query_params.get('driver1')}, "
                f"d2:{query_params.get('driver2')}, l1:{query_params.get('lap1')}, l2:{query_params.get('lap2')}, "
                f"force:{query_params.get('force_refresh', False)}}} timeout={self.timeout}s"
            )
            net_ts = time.perf_counter()
            response = requests.post(
                endpoint,
                params=query_params,
                timeout=self.timeout,
                headers={"Accept": "application/json"}
            )
            self.progress.emit(70)
            response.raise_for_status()
            self._log(
                f"HTTP {response.status_code}; latency={(time.perf_counter()-net_ts)*1000:.1f}ms; "
                f"content_length={response.headers.get('Content-Length') or len(response.content)}"
            )

            payload = response.json()
            if not isinstance(payload, dict):
                raise ValueError("API response must be a JSON object")
            if not payload.get("success", False):
                raise RuntimeError(payload.get("message", "API returned success=False"))

            data = payload.get("data")
            if not isinstance(data, dict):
                raise ValueError("API response missing 'data' object")

            latency_ms = (time.perf_counter() - start_ts) * 1000.0
            meta = {
                "source": payload.get("source", "api"),
                "execution_time": payload.get("execution_time"),
                "request_id": payload.get("request_id"),
                "timestamp": payload.get("timestamp"),
                "latency_ms": round(latency_ms, 2),
                "base_url": self.base_url,
                "function_id": 13,
            }

            self.progress.emit(90)
            result = {
                "data": data,
                "payload": payload,
                "meta": meta,
                "request_token": self.request_token
            }
            # ?亙歇鋡怨?瘙葉?瘀?隞???銝??靽∟?嚗?撠?蝥????
            if self.isInterruptionRequested():
                self._log("interruption requested after response; skip success.emit")
            else:
                self.success.emit(result)
        except Exception as exc:
            self._log(f"failure: {exc}")
            try:
                self._log(traceback.format_exc())
            except Exception:
                pass
            try:
                self.failure.emit(str(exc))
            except Exception:
                pass
        finally:
            try:
                self.progress.emit(100)
            except Exception:
                pass
            elapsed = (time.perf_counter() - start_ts) * 1000.0
            self._log(f"run() end; elapsed={elapsed:.1f}ms interruption={self.isInterruptionRequested()}")


