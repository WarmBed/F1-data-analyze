    "last_updated": "2025-12-03",
    "sources": [
      "Academic Research: Data-driven pit stop decision support (NIH/PMC 2025)",
      "FIA Technical Regulations 2024",
      "Historical Race Data Analysis 2022-2024"
    ],
    "notes": {
      "fuel_kg_per_lap": "每圈燃油消耗量 (公斤)",
      "fuel_effect_coefficient": "燃油對圈速的影響係數 (秒/公斤)",
      "start_fuel_kg": "起跑燃油量 (通常 105-110 kg)",
      "calculation": "corrected_time = actual_time + fuel_effect_coef * fuel_consumed"
    },
    "research_reference": {
      "typical_fuel_effect": "0.030 - 0.035 s/kg",
      "typical_fuel_consumption": "1.4 - 2.3 kg/lap depending on track"
    }
  },

