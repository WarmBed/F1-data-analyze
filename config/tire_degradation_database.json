{
  "_metadata": {
    "version": "1.0.0",
    "description": "F1 賽道輪胎衰退係數資料庫 - 用於輪胎衰退分析 (時變線性模型)",
    "last_updated": "2025-12-30",
    "sources": [
      "Cappello & Hoegh 2025 - Tire degradation analysis",
      "Fuel-corrected lap time linear regression",
      "Total analyzed stints: 855"
    ],
    "model_description": {
      "type": "Time-Varying Linear Degradation",
      "formula": "degradation(t) = base_rate + acceleration * tire_age",
      "total_degradation": "∑(degradation(t)) = base_rate * laps + 0.5 * acceleration * laps²",
      "units": {
        "base_degradation": "seconds per lap (s/lap)",
        "degradation_acceleration": "seconds per lap² (s/lap²)"
      }
    },
    "research_reference": {
      "typical_degradation_rate": "0.04-0.10 s/lap (compound dependent)",
      "typical_acceleration": "0.001-0.005 s/lap² (compound dependent)",
      "soft_vs_hard_ratio": "Soft degrades ~2x faster than Hard",
      "key_finding": "Linear model is industry standard, sufficient for practical use"
    },
    "training_method": "Cappello & Hoegh 2025 lap time degradation analysis"
  },
  "compounds": {
    "SOFT": {
      "description": "最軟配方 - 最快但衰退最快",
      "typical_optimal_stint": "15-20 laps",
      "grip_advantage_seconds": -0.5,
      "notes": "高抓地力，適合短 stint 策略"
    },
    "MEDIUM": {
      "description": "中性配方 - 平衡速度與耐久",
      "typical_optimal_stint": "25-35 laps",
      "grip_advantage_seconds": -0.25,
      "notes": "最常用的比賽配方"
    },
    "HARD": {
      "description": "最硬配方 - 最慢但最耐久",
      "typical_optimal_stint": "35-50 laps",
      "grip_advantage_seconds": 0.0,
      "notes": "適合長 stint 或高衰退賽道"
    }
  },
