{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "🎯 執行 F1T GUI 主程式",
			"type": "shell",
			"command": "python",
			"args": [
				"f1t_gui_main.py"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"PYTHONIOENCODING": "utf-8",
					"PYTHONLEGACYWINDOWSFS": "0"
				},
				"shell": {
					"executable": "powershell.exe",
					"args": [
						"-NoProfile",
						"-Command"
					]
				}
			},
			"problemMatcher": {
				"owner": "python",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"runOptions": {
				"runOn": "default"
			},
			"isBackground": false
		},
		{
			"label": "🛑 強制關閉 F1T GUI",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-Command",
				"Get-Process python -ErrorAction SilentlyContinue | Stop-Process -Force; Write-Host 'F1T GUI 已強制關閉' -ForegroundColor Green"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "powershell.exe"
				}
			},
			"problemMatcher": []
		},
		{
			"label": "🔄 重啟 F1T GUI",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-Command",
				"Get-Process python -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Seconds 2; python f1t_gui_main.py"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"PYTHONIOENCODING": "utf-8",
					"PYTHONLEGACYWINDOWSFS": "0"
				},
				"shell": {
					"executable": "powershell.exe"
				}
			},
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "🔧 執行 CLI 模組化主程式",
			"type": "shell",
			"command": "python",
			"args": [
				"f1_analysis_modular_main.py",
				"-f",
				"1",
				"-y",
				"2025",
				"-r",
				"Japan",
				"-s",
				"R"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"PYTHONIOENCODING": "utf-8"
				}
			},
			"problemMatcher": "$python"
		},
		{
			"label": "🌐 啟動 API 伺服器",
			"type": "shell",
			"command": "python",
			"args": [
				"refactored_api.py"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"PYTHONIOENCODING": "utf-8"
				}
			},
			"problemMatcher": "$python",
			"isBackground": true
		},
		{
			"label": "🧪 執行所有測試",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pytest",
				"tests/",
				"-v",
				"--tb=short"
			],
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PYTHONPATH": "${workspaceFolder}",
					"PYTHONIOENCODING": "utf-8"
				}
			},
			"problemMatcher": "$python"
		},
		{
			"label": "🧹 清理緩存檔案",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-Command",
				"Remove-Item -Path 'cache\\*.pkl' -Force -ErrorAction SilentlyContinue; Remove-Item -Path '__pycache__\\*' -Recurse -Force -ErrorAction SilentlyContinue; Write-Host '緩存檔案清理完成'"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "📦 安裝 Python 相依套件",
			"type": "shell",
			"command": "pip",
			"args": [
				"install",
				"-r",
				"requirements.txt"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new",
				"showReuseMessage": true,
				"clear": false
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "🌐 啟動 Cloudflare Tunnel",
			"type": "shell",
			"command": "${workspaceFolder}\\cloudflared\\cloudflared.exe",
			"args": [
				"--config",
				"${workspaceFolder}\\cloudflared\\config.yml",
				"tunnel",
				"run",
				"myfastapi"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}\\cloudflared"
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "🚀 啟動所有 F1T 服務",
			"type": "shell",
			"command": "${workspaceFolder}\\nssm\\Start_All_Services.bat",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "new",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "🛑 關閉所有 F1T 服務",
			"type": "shell",
			"command": "${workspaceFolder}\\nssm\\Stop_All_Services.bat",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "new",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "🔄 重啟所有 F1T 服務",
			"type": "shell",
			"command": "${workspaceFolder}\\nssm\\Restart_All_Services.bat",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "new",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "📊 查看 F1T 服務狀態",
			"type": "shell",
			"command": "${workspaceFolder}\\nssm\\Check_Service_Status.bat",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "new",
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "分析採樣率",
			"type": "shell",
			"command": "python",
			"args": [
				"temp_sampling_rate.py"
			]
		},
		{
			"label": "Test Abu Dhabi Overtakes",
			"type": "shell",
			"command": "python test_abu_dhabi_overtakes.py"
		},
		{
			"label": "Test Abu Dhabi Overtakes 2",
			"type": "shell",
			"command": "python test_abu_dhabi_overtakes.py"
		},
		{
			"label": "Test Abu Dhabi 3",
			"type": "shell",
			"command": "python test_abu_dhabi_overtakes.py"
		},
		{
			"label": "Test Overtake Simple",
			"type": "shell",
			"command": "python test_overtake_simple.py"
		},
		{
			"label": "Regenerate Abu Dhabi F100",
			"type": "shell",
			"command": "python f1_analysis_modular_main.py -f 100 -y 2025 -r \"Abu Dhabi\""
		},
		{
			"label": "Regenerate Abu Dhabi F100 v2",
			"type": "shell",
			"command": "python f1_analysis_modular_main.py -f 100 -y 2025 -r Abu_Dhabi"
		},
		{
			"label": "Regenerate Abu Dhabi F100",
			"type": "shell",
			"command": "python",
			"args": [
				"f1_analysis_modular_main.py",
				"-f",
				"100",
				"-y",
				"2025",
				"-r",
				"Abu Dhabi",
				"-s",
				"R"
			]
		},
		{
			"label": "Regenerate Abu Dhabi F100 v2",
			"type": "shell",
			"command": "python",
			"args": [
				"f1_analysis_modular_main.py",
				"-f",
				"100",
				"-r",
				"'Abu Dhabi'"
			]
		},
		{
			"label": "Regenerate Abu Dhabi F100 v3",
			"type": "shell",
			"command": "python",
			"args": [
				"f1_analysis_modular_main.py",
				"-f",
				"100",
				"-r",
				"Abu_Dhabi"
			]
		},
		{
			"label": "Debug F100 Abu Dhabi",
			"type": "shell",
			"command": "python",
			"args": [
				"debug_f100_abu_dhabi.py"
			]
		},
		{
			"label": "Debug F100 v2",
			"type": "shell",
			"command": "python debug_f100_abu_dhabi.py 2>&1"
		},
		{
			"label": "Regenerate F100 Abu Dhabi",
			"type": "shell",
			"command": "python f1_analysis_modular_main.py -f 100 -y 2025 -r \"Abu Dhabi\" -s R 2>&1"
		},
		{
			"label": "Regen F100",
			"type": "shell",
			"command": "python regenerate_f100_abu_dhabi.py 2>&1"
		},
		{
			"label": "Regen F100 LiveTiming",
			"type": "shell",
			"command": "python regenerate_f100_abu_dhabi.py"
		},
		{
			"label": "F100 LiveTiming v2",
			"type": "shell",
			"command": "python regenerate_f100_abu_dhabi.py"
		}
	]
}