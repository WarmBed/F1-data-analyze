{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/f1t_gui_main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8",
    "F1_API_HOST": "127.0.0.1",
    "F1_API_PORT": "8000",
    "F1_API_BASE_URL": "https://api.f1telemetrystationpro.org"
      },
      "justMyCode": false,
      "stopOnEntry": false
    },
    {
      "name": "Python: API server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/refactored_api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8",
        "F1_API_HOST": "127.0.0.1",
        "F1_API_PORT": "8000",
        "F1_API_RELOAD": "0"
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://\\S+)",
        "uriFormat": "%s/docs",
        "action": "openExternally"
      },
      "justMyCode": false,
      "stopOnEntry": false
    },
    {
      "name": "Python: CLI entry (interactive)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/f1_analysis_modular_main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "justMyCode": false,
      "stopOnEntry": false
    },
    {
      "name": "Python: Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      },
      "args": [
        "tests/",
        "-v",
        "--tb=short"
      ],
      "justMyCode": false,
      "stopOnEntry": false
    },
    {
      "name": "🌐 Cloudflare Tunnel",
      "type": "node-terminal",
      "request": "launch",
      "command": "${workspaceFolder}\\cloudflared\\cloudflared.exe --config ${workspaceFolder}\\cloudflared\\config.yml tunnel run myfastapi",
      "cwd": "${workspaceFolder}\\cloudflared"
    },
    {
      "name": "📦 打包 EXE (PyInstaller)",
      "type": "node-terminal",
      "request": "launch",
      "command": "python -m PyInstaller F1T_GUI.spec",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": false,
        "group": "F1T - 建置",
        "order": 1
      }
    },
    {
      "name": "📦 清理並重新打包 EXE",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -NoProfile -Command \"Remove-Item dist -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item build -Recurse -Force -ErrorAction SilentlyContinue; python -m PyInstaller F1T_GUI.spec\"",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": false,
        "group": "F1T - 建置",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "🎯 只啟動 GUI",
      "configurations": [
        "Python: GUI"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "F1T - 開發模式",
        "order": 1
      }
    },
    {
      "name": "🚀 GUI + API (本地開發)",
      "configurations": [
        "Python: API server",
        "Python: GUI"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "F1T - 開發模式",
        "order": 2
      }
    },
    {
      "name": "🌐 API + Cloudflare Tunnel (對外開放)",
      "configurations": [
        "Python: API server",
        "🌐 Cloudflare Tunnel"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "F1T - 生產模式",
        "order": 1
      }
    },
    {
      "name": "🌍 完整系統 (API + Tunnel + GUI)",
      "configurations": [
        "Python: API server",
        "🌐 Cloudflare Tunnel",
        "Python: GUI"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "F1T - 生產模式",
        "order": 2
      }
    }
  ]
}
